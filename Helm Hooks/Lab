Subtask 2.5: Update Main Application Deployment
Modify the main deployment to use the ConfigMap created by the pre-install hook:

nano templates/deployment.yaml
Replace the content with:

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "webapp-with-hooks.fullname" . }}
  labels:
    {{- include "webapp-with-hooks.labels" . | nindent 4 }}
spec:
  {{- if not .Values.autoscaling.enabled }}
  replicas: {{ .Values.replicaCount }}
  {{- end }}
  selector:
    matchLabels:
      {{- include "webapp-with-hooks.selectorLabels" . | nindent 6 }}
  template:
    metadata:
      {{- with .Values.podAnnotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      labels:
        {{- include "webapp-with-hooks.selectorLabels" . | nindent 8 }}
    spec:
      containers:
        - name: {{ .Chart.Name }}
          image: "{{ .Values.image.repository }}:{{ .Values.image.tag | default .Chart.AppVersion }}"
          imagePullPolicy: {{ .Values.image.pullPolicy }}
          ports:
            - name: http
              containerPort: 80
              protocol: TCP
          env:
            - name: CONFIG_SOURCE
              value: "helm-hook-generated"
          volumeMounts:
            - name: config-volume
              mountPath: /etc/config
          livenessProbe:
            httpGet:
              path: /
              port: http
          readinessProbe:
            httpGet:
              path: /
              port: http
          resources:
            {{- toYaml .Values.resources | nindent 12 }}
      volumes:
        - name: config-volume
          configMap:
            name: "{{ include "webapp-with-hooks.fullname" . }}-initial-config"
Task 3: Automate Kubernetes Job Execution
Subtask 3.1: Create Test Hook
Create a test hook to demonstrate job automation:

nano templates/hooks/test-hook.yaml
Add the following content:

apiVersion: v1
kind: Pod
metadata:
  name: "{{ include "webapp-with-hooks.fullname" . }}-test"
  labels:
    {{- include "webapp-with-hooks.labels" . | nindent 4 }}
  annotations:
    "helm.sh/hook": test
    "helm.sh/hook-delete-policy": before-hook-creation,hook-succeeded
spec:
  restartPolicy: Never
  containers:
  - name: test
    image: busybox:1.35
    command:
    - /bin/sh
    - -c
    - |
      echo "Running application tests..."
      echo "Testing configuration..."
      if [ -f /etc/config/app.properties ]; then
        echo "Configuration file found!"
        cat /etc/config/app.properties
      else
        echo "Configuration file not found!"
        exit 1
      fi
      echo "Testing network connectivity..."
      nslookup {{ include "webapp-with-hooks.fullname" . }}
      echo "All tests passed successfully!"
    volumeMounts:
    - name: config-volume
      mountPath: /etc/config
  volumes:
  - name: config-volume
    configMap:
      name: "{{ include "webapp-with-hooks.fullname" . }}-initial-config"
