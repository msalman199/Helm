Task 5: Advanced Hook Scenarios
Subtask 5.1: Create Conditional Hooks
Create a hook that runs conditionally based on values:

nano templates/hooks/conditional-hook.yaml
Add the following content:

{{- if .Values.hooks.enabled }}
{{- if .Values.hooks.preInstall.enabled }}
apiVersion: batch/v1
kind: Job
metadata:
  name: "{{ include "webapp-with-hooks.fullname" . }}-conditional-setup"
  labels:
    {{- include "webapp-with-hooks.labels" . | nindent 4 }}
  annotations:
    "helm.sh/hook": pre-install
    "helm.sh/hook-weight": "-2"
    "helm.sh/hook-delete-policy": before-hook-creation,hook-succeeded
spec:
  template:
    metadata:
      name: "{{ include "webapp-with-hooks.fullname" . }}-conditional-setup"
      labels:
        {{- include "webapp-with-hooks.selectorLabels" . | nindent 8 }}
    spec:
      restartPolicy: Never
      containers:
      - name: conditional-setup
        image: busybox:1.35
        command:
        - /bin/sh
        - -c
        - |
          echo "Running conditional pre-install setup..."
          echo "Environment: {{ .Values.app.environment }}"
          echo "Debug mode: {{ .Values.app.debug }}"
          {{- if .Values.app.monitoring.enabled }}
          echo "Monitoring is enabled"
          {{- else }}
          echo "Monitoring is disabled"
          {{- end }}
          echo "Conditional setup completed!"
          sleep 8
{{- end }}
{{- end }}
