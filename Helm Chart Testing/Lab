Subtask 3.7: Create Test Automation Script
Create a script to automate the testing process.

# Create test automation script
cat << 'EOF' > test-automation.sh
#!/bin/bash

set -e

NAMESPACE="helm-testing"
RELEASE_NAME="webapp-test"
CHART_PATH="webapp/"

echo "=== Helm Chart Testing Automation ==="

# Function to run tests and capture results
run_tests() {
    local test_phase="$1"
    echo "Running tests for phase: $test_phase"
    
    if helm test $RELEASE_NAME --namespace $NAMESPACE --logs; then
        echo "✓ Tests passed for $test_phase"
        return 0
    else
        echo "✗ Tests failed for $test_phase"
        return 1
    fi
}

# Function to check deployment status
check_deployment() {
    echo "Checking deployment status..."
    kubectl wait --for=condition=available --timeout=300s deployment/$RELEASE_NAME --namespace $NAMESPACE
    echo "✓ Deployment is ready"
}

# Main testing workflow
echo "1. Installing chart..."
helm install $RELEASE_NAME $CHART_PATH --namespace $NAMESPACE --wait

echo "2. Checking deployment..."
check_deployment

echo "3. Running initial tests..."
run_tests "initial-install"

echo "4. Upgrading chart..."
helm upgrade $RELEASE_NAME $CHART_PATH --namespace $NAMESPACE --set replicaCount=3 --wait

echo "5. Checking upgraded deployment..."
check_deployment

echo "6. Running upgrade tests..."
run_tests "post-upgrade"

echo "7. Testing rollback..."
helm rollback $RELEASE_NAME 1 --namespace $NAMESPACE --wait

echo "8. Running rollback tests..."
run_tests "post-rollback"

echo "=== All tests completed successfully ==="
EOF

# Make script executable
chmod +x test-automation.sh

# Clean up previous installation
helm uninstall webapp-test --namespace helm-testing || true

# Run automated tests
./test-automation.sh
