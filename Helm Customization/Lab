Subtask 3.4: Upgrade and Rollback Operations
Step 1: Modify application and create new version

# Go back to application directory
cd ~/microservice-app

# Update server.js with new version
cat << EOF > server.js
const express = require('express');
const app = express();
const port = process.env.PORT || 3000;

app.get('/', (req, res) => {
  res.json({
    message: 'Hello from Custom Microservice v2!',
    service: process.env.SERVICE_NAME || 'unknown',
    version: process.env.SERVICE_VERSION || '2.0.0',
    timestamp: new Date().toISOString(),
    features: ['health-check', 'metrics', 'logging']
  });
});

app.get('/health', (req, res) => {
  res.json({ 
    status: 'healthy',
    version: '2.0.0',
    uptime: process.uptime()
  });
});

app.get('/metrics', (req, res) => {
  res.json({
    requests: Math.floor(Math.random() * 1000),
    memory: process.memoryUsage(),
    uptime: process.uptime()
  });
});

app.listen(port, () => {
  console.log(\`Server v2.0.0 running on port \${port}\`);
});
EOF

