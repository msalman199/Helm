# Test connectivity to applications in each cluster
test_app_connectivity() {
    local context=$1
    local app_name=$2
    
    echo "Testing connectivity in $context..."
    kubectl config use-context $context
    
    # Get service details
    kubectl get service $app_name-multi-cluster-app -n web-apps
    
    # Port forward and test (run in background)
    kubectl port-forward service/$app_name-multi-cluster-app 8080:80 -n web-apps &
    PID=$!
    
    # Wait a moment for port forward to establish
    sleep 3
    
    # Test connection
    curl -s http://localhost:8080 | head -n 5 || echo "Connection test failed"
    
    # Kill port forward
    kill $PID 2>/dev/null
    
    echo "---"
}

# Test all clusters
test_app_connectivity "dev-cluster" "dev-app"
test_app_connectivity "staging-cluster" "staging-app"
test_app_connectivity "prod-cluster" "prod-app"
