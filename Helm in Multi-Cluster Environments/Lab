Subtask 2.4: Implement Cross-Cluster Application Updates
Step 1: Create an update script for rolling updates across clusters

cat << 'EOF' > update-multi-cluster.sh
#!/bin/bash

# Multi-cluster update script
CHART_PATH="./multi-cluster-app"
NAMESPACE="web-apps"
NEW_IMAGE_TAG=${1:-"1.22"}

# Function to update application in a cluster
update_cluster() {
    local context=$1
    local values_file=$2
    local release_name=$3
    
    echo "Updating application in cluster: $context to image tag: $NEW_IMAGE_TAG"
    kubectl config use-context $context
    
    # Update the application with new image tag
    helm upgrade $release_name $CHART_PATH \
        -f $CHART_PATH/$values_file \
        --set image.tag=$NEW_IMAGE_TAG \
        -n $NAMESPACE
    
    # Wait for rollout to complete
    kubectl rollout status deployment/$release_name-multi-cluster-app -n $NAMESPACE
    
    echo "Update completed for $context"
    echo "---"
}

echo "Starting multi-cluster update to image tag: $NEW_IMAGE_TAG"

# Update clusters in order: dev -> staging -> production
update_cluster "dev-cluster" "values-dev.yaml" "dev-app"
echo "Development update completed. Proceeding to staging..."

update_cluster "staging-cluster" "values-staging.yaml" "staging-app"
echo "Staging update completed. Proceeding to production..."

update_cluster "prod-cluster" "values-prod.yaml" "prod-app"

echo "Multi-cluster update completed successfully!"
EOF

# Make the script executable
chmod +x update-multi-cluster.sh
