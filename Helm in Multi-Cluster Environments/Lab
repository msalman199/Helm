Task 1: Set up Helm in a Multi-Cluster Environment
Subtask 1.1: Install Required Tools
First, we need to install Docker, kubectl, kind (Kubernetes in Docker), and Helm on our Linux machine.

Step 1: Update the system and install Docker

# Update package list
sudo apt update

# Install required packages
sudo apt install -y apt-transport-https ca-certificates curl gnupg lsb-release

# Add Docker's official GPG key
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg

# Add Docker repository
echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

# Update package list again
sudo apt update

# Install Docker
sudo apt install -y docker-ce docker-ce-cli containerd.io

# Add current user to docker group
sudo usermod -aG docker $USER

# Start and enable Docker service
sudo systemctl start docker
sudo systemctl enable docker
Step 2: Install kubectl

# Download kubectl
curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"

# Make kubectl executable
chmod +x kubectl

# Move kubectl to PATH
sudo mv kubectl /usr/local/bin/

# Verify installation
kubectl version --client
Step 3: Install kind (Kubernetes in Docker)

# Download kind
curl -Lo ./kind https://kind.sigs.k8s.io/dl/v0.20.0/kind-linux-amd64

# Make kind executable
chmod +x ./kind

# Move kind to PATH
sudo mv ./kind /usr/local/bin/kind

# Verify installation
kind version
Step 4: Install Helm

# Download Helm installation script
curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

# Verify Helm installation
helm version
Step 5: Restart session to apply Docker group changes

# Log out and log back in, or use newgrp
newgrp docker
Subtask 1.2: Create Multiple Kubernetes Clusters
Now we'll create three different Kubernetes clusters to simulate a multi-cluster environment.

Step 1: Create cluster configuration files

Create a configuration file for the production cluster:

cat << EOF > prod-cluster-config.yaml
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: production
nodes:
- role: control-plane
  kubeadmConfigPatches:
  - |
    kind: InitConfiguration
    nodeRegistration:
      kubeletExtraArgs:
        node-labels: "environment=production"
- role: worker
  kubeadmConfigPatches:
  - |
    kind: JoinConfiguration
    nodeRegistration:
      kubeletExtraArgs:
        node-labels: "environment=production"
EOF
Create a configuration file for the staging cluster:

cat << EOF > staging-cluster-config.yaml
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: staging
nodes:
- role: control-plane
  kubeadmConfigPatches:
  - |
    kind: InitConfiguration
    nodeRegistration:
      kubeletExtraArgs:
        node-labels: "environment=staging"
- role: worker
  kubeadmConfigPatches:
  - |
    kind: JoinConfiguration
    nodeRegistration:
      kubeletExtraArgs:
        node-labels: "environment=staging"
EOF
Create a configuration file for the development cluster:

cat << EOF > dev-cluster-config.yaml
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: development
nodes:
- role: control-plane
  kubeadmConfigPatches:
  - |
    kind: InitConfiguration
    nodeRegistration:
      kubeletExtraArgs:
        node-labels: "environment=development"
EOF
Step 2: Create the clusters

# Create production cluster
kind create cluster --config=prod-cluster-config.yaml

# Create staging cluster
kind create cluster --config=staging-cluster-config.yaml

# Create development cluster
kind create cluster --config=dev-cluster-config.yaml
Step 3: Verify cluster creation

# List all kind clusters
kind get clusters

# Check kubectl contexts
kubectl config get-contexts
