Subtask 2.3: Create Multi-Cluster Deployment Scripts
Step 1: Create a deployment script for all clusters

cd ..
cat << 'EOF' > deploy-multi-cluster.sh
#!/bin/bash

# Multi-cluster deployment script
CHART_PATH="./multi-cluster-app"
NAMESPACE="web-apps"

# Function to deploy to a cluster
deploy_to_cluster() {
    local context=$1
    local values_file=$2
    local release_name=$3
    
    echo "Deploying to cluster: $context"
    kubectl config use-context $context
    
    # Check if namespace exists, create if not
    kubectl get namespace $NAMESPACE >/dev/null 2>&1 || kubectl create namespace $NAMESPACE
    
    # Deploy or upgrade the application
    helm upgrade --install $release_name $CHART_PATH -f $CHART_PATH/$values_file -n $NAMESPACE
    
    # Wait for deployment to be ready
    kubectl rollout status deployment/$release_name-multi-cluster-app -n $NAMESPACE
    
    echo "Deployment to $context completed successfully"
    echo "---"
}

# Deploy to all clusters
deploy_to_cluster "dev-cluster" "values-dev.yaml" "dev-app"
deploy_to_cluster "staging-cluster" "values-staging.yaml" "staging-app"
deploy_to_cluster "prod-cluster" "values-prod.yaml" "prod-app"

echo "Multi-cluster deployment completed!"
EOF

# Make the script executable
chmod +x deploy-multi-cluster.sh
