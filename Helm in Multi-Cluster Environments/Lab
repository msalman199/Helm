Subtask 2.6: Create Monitoring and Management Tools
Step 1: Create a comprehensive cluster management script

cat << 'EOF' > manage-clusters.sh
#!/bin/bash

# Comprehensive cluster management script

show_help() {
    echo "Usage: $0 [COMMAND] [OPTIONS]"
    echo ""
    echo "Commands:"
    echo "  status      Show status of all clusters"
    echo "  deploy      Deploy applications to all clusters"
    echo "  update      Update applications in all clusters"
    echo "  cleanup     Remove all applications from clusters"
    echo "  resources   Show resource usage across clusters"
    echo ""
    echo "Options:"
    echo "  --tag TAG   Specify image tag for updates"
    echo "  --help      Show this help message"
}

show_cluster_resources() {
    local context=$1
    echo "Resource usage for $context:"
    kubectl config use-context $context
    kubectl top nodes 2>/dev/null || echo "Metrics server not available"
    kubectl get pods --all-namespaces -o wide | grep -E "(Running|Pending|Failed)"
    echo "---"
}

cleanup_cluster() {
    local context=$1
    echo "Cleaning up $context..."
    kubectl config use-context $context
    
    # Remove Helm releases
    helm uninstall dev-app -n web-apps 2>/dev/null || true
    helm uninstall staging-app -n web-apps 2>/dev/null || true
    helm uninstall prod-app -n web-apps 2>/dev/null || true
    
    helm uninstall dev-postgres -n databases 2>/dev/null || true
    helm uninstall staging-postgres -n databases 2>/dev/null || true
    helm uninstall prod-postgres -n databases 2>/dev/null || true
    
    echo "Cleanup completed for $context"
}

case "$1" in
    status)
        ./check-multi-cluster-status.sh
        ;;
    deploy)
        ./deploy-multi-cluster.sh
        ;;
    update)
        TAG=${2:-"1.22"}
        ./update-multi-cluster.sh $TAG
        ;;
    cleanup)
        cleanup_cluster "dev-cluster"
        cleanup_cluster "staging-cluster"
        cleanup_cluster "prod-cluster"
        ;;
    resources)
        show_cluster_resources "dev-cluster"
        show_cluster_resources "staging-cluster"
        show_cluster_resources "prod-cluster"
        ;;
    --help|help)
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
EOF

# Make the script executable
chmod +x manage-clusters.sh
