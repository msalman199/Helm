Subtask 3.5: Create Helm Release Health Alerts
Create alerting rules for Helm release monitoring.

# Create PrometheusRule for Helm monitoring
cat << EOF > helm-alerts.yaml
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: helm-alerts
  namespace: monitoring
  labels:
    app: helm-monitoring
spec:
  groups:
  - name: helm.rules
    rules:
    - alert: HelmReleaseFailed
      expr: kube_pod_status_phase{phase="Failed"} > 0
      for: 5m
      labels:
        severity: warning
      annotations:
        summary: "Helm release pod failed"
        description: "Pod {{ \$labels.pod }} in namespace {{ \$labels.namespace }} has failed"
    
    - alert: HelmReleaseHighMemoryUsage
      expr: container_memory_usage_bytes / container_spec_memory_limit_bytes > 0.8
      for: 10m
      labels:
        severity: warning
      annotations:
        summary: "High memory usage in Helm release"
        description: "Container {{ \$labels.container }} is using more than 80% of memory"
    
    - alert: HelmReleasePodRestarting
      expr: rate(kube_pod_container_status_restarts_total[15m]) > 0
      for: 5m
      labels:
        severity: warning
      annotations:
        summary: "Helm release pod restarting"
        description: "Pod {{ \$labels.pod }} is restarting frequently"
EOF

# Apply the alerting rules
kubectl apply -f helm-alerts.yaml

# Verify PrometheusRule creation
kubectl get prometheusrule -n monitoring
Task 4: Advanced Monitoring Configuration
Subtask 4.1: Create Custom Metrics Exporter
Create a simple metrics exporter to demonstrate custom monitoring.

# Create a simple Python metrics exporter
cat << EOF > metrics-exporter.py
#!/usr/bin/env python3
from prometheus_client import start_http_server, Summary, Counter, Gauge
import random
import time

# Create metrics
REQUEST_TIME = Summary('request_processing_seconds', 'Time spent processing request')
REQUEST_COUNT = Counter('requests_total', 'Total requests', ['method', 'endpoint'])
HELM_RELEASES = Gauge('helm_releases_total', 'Total number of Helm releases')

@REQUEST_TIME.time()
def process_request(t):
    time.sleep(t)

if __name__ == '__main__':
    start_http_server(8000)
    while True:
        process_request(random.random())
        REQUEST_COUNT.labels(method='GET', endpoint='/api').inc()
        HELM_RELEASES.set(random.randint(1, 10))
        time.sleep(1)
EOF

# Create Dockerfile for the exporter
cat << EOF > Dockerfile
FROM python:3.9-slim
RUN pip install prometheus_client
COPY metrics-exporter.py /app/
WORKDIR /app
EXPOSE 8000
CMD ["python", "metrics-exporter.py"]
EOF

# Build and run the custom exporter
docker build -t custom-exporter .
docker run -d --name custom-exporter -p 8000:8000 custom-exporter
Subtask 4.2: Configure Service Discovery
Create service discovery configuration for automatic monitoring.

# Create ServiceMonitor for custom exporter
cat << EOF > custom-exporter-monitor.yaml
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: custom-exporter
  namespace: monitoring
spec:
  selector:
    matchLabels:
      app: custom-exporter
  endpoints:
  - port: metrics
    interval: 15s
---
apiVersion: v1
kind: Service
metadata:
  name: custom-exporter-service
  namespace: monitoring
  labels:
    app: custom-exporter
spec:
  type: ClusterIP
  ports:
  - port: 8000
    targetPort: 8000
    name: metrics
  selector:
    app: custom-exporter
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: custom-exporter
  namespace: monitoring
spec:
  replicas: 1
  selector:
    matchLabels:
      app: custom-exporter
  template:
    metadata:
      labels:
        app: custom-exporter
    spec:
      containers:
      - name: custom-exporter
        image: custom-exporter:latest
        imagePullPolicy: Never
        ports:
        - containerPort: 8000
EOF

# Apply the configuration
kubectl apply -f custom-exporter-monitor.yaml
