Subtask 5.5: Performance Testing
Generate load to test monitoring capabilities.

# Create a load testing script
cat << EOF > load-test.sh
#!/bin/bash
echo "Starting load test..."
for i in {1..100}; do
  kubectl run load-test-\$i --image=busybox --restart=Never --rm -i --tty -- sleep 10 &
  if [ \$((i % 10)) -eq 0 ]; then
    echo "Created \$i pods..."
    sleep 5
  fi
done
wait
echo "Load test completed"
EOF

chmod +x load-test.sh

# Run load test in background
./load-test.sh &

# Monitor metrics during load test
watch -n 5 'curl -s http://localhost:30000/api/v1/query?query=kube_pod_info | jq ".data.result | length"'
