Task 6: Monitoring and Logging for Debugging
Subtask 6.1: Set up Monitoring
Step 1: Create a monitoring script

# Create a monitoring script
cat << 'EOF' > monitor-helm-release.sh
#!/bin/bash

RELEASE_NAME=$1
NAMESPACE=${2:-default}

if [ -z "$RELEASE_NAME" ]; then
    echo "Usage: $0 <release-name> [namespace]"
    exit 1
fi

echo "=== Helm Release Status ==="
helm status $RELEASE_NAME -n $NAMESPACE

echo -e "\n=== Kubernetes Resources ==="
kubectl get all -l app.kubernetes.io/instance=$RELEASE_NAME -n $NAMESPACE

echo -e "\n=== Pod Details ==="
kubectl describe pods -l app.kubernetes.io/instance=$RELEASE_NAME -n $NAMESPACE

echo -e "\n=== Recent Events ==="
kubectl get events --sort-by=.metadata.creationTimestamp -n $NAMESPACE | tail -10

echo -e "\n=== Pod Logs ==="
kubectl logs -l app.kubernetes.io/instance=$RELEASE_NAME -n $NAMESPACE --tail=20
EOF

chmod +x monitor-helm-release.sh
