Subtask 2.5: Implement Canary Deployment
Create a canary deployment setup:

# Create canary values file
cat << 'EOF' > canary-values.yaml
replicaCount: 1

image:
  repository: sample-app
  pullPolicy: Never
  tag: "v2.0"

nameOverride: "canary"
fullnameOverride: "sample-app-canary"

service:
  type: ClusterIP
  port: 80

ingress:
  enabled: true
  className: "nginx"
  annotations:
    nginx.ingress.kubernetes.io/canary: "true"
    nginx.ingress.kubernetes.io/canary-weight: "10"
  hosts:
    - host: sample-app.local
      paths:
        - path: /
          pathType: Prefix

canary:
  enabled: true
  weight: 10
EOF

# First, ensure main app is on v1.0
helm upgrade sample-app ./sample-app-chart --set image.tag=v1.0

# Deploy canary version
helm install sample-app-canary ./sample-app-chart -f canary-values.yaml

# Check both deployments
kubectl get deployments
kubectl get pods -l app.kubernetes.io/name=sample-app-chart

# Test canary deployment (run multiple times to see traffic split)
for i in {1..20}; do
  curl -s -H "Host: sample-app.local" http://localhost/ | grep -o "Version [0-9.]*"
  sleep 1
done
