Subtask 2.8: Switch Traffic in Blue-Green Deployment
# Create a script to switch traffic
cat << 'EOF' > switch-traffic.sh
#!/bin/bash

ENVIRONMENT=$1

if [ "$ENVIRONMENT" = "blue" ]; then
    kubectl patch ingress sample-app-sample-app-chart -p '{"spec":{"rules":[{"host":"sample-app.local","http":{"paths":[{"path":"/","pathType":"Prefix","backend":{"service":{"name":"sample-app-sample-app-chart","port":{"number":80}}}}]}}]}}'
    echo "Traffic switched to BLUE environment"
elif [ "$ENVIRONMENT" = "green" ]; then
    kubectl patch ingress sample-app-sample-app-chart -p '{"spec":{"rules":[{"host":"sample-app.local","http":{"paths":[{"path":"/","pathType":"Prefix","backend":{"service":{"name":"sample-app-green","port":{"number":80}}}}]}}]}}'
    echo "Traffic switched to GREEN environment"
else
    echo "Usage: $0 [blue|green]"
    exit 1
fi
EOF

chmod +x switch-traffic.sh

# Switch to green environment
./switch-traffic.sh green

# Test the switch
curl -H "Host: sample-app.local" http://localhost/

# Switch back to blue if needed
./switch-traffic.sh blue
curl -H "Host: sample-app.local" http://localhost/
Subtask 2.9: Advanced Rollout Monitoring
Create monitoring and health check scripts:

# Create deployment monitoring script
cat << 'EOF' > monitor-deployment.sh
#!/bin/bash

DEPLOYMENT_NAME=$1
NAMESPACE=${2:-default}

if [ -z "$DEPLOYMENT_NAME" ]; then
    echo "Usage: $0 <deployment-name> [namespace]"
    exit 1
fi

echo "Monitoring deployment: $DEPLOYMENT_NAME in namespace: $NAMESPACE"
echo "=================================================="

# Monitor rollout status
kubectl rollout status deployment/$DEPLOYMENT_NAME -n $NAMESPACE --timeout=300s

# Check final status
echo -e "\nFinal Deployment Status:"
kubectl get deployment $DEPLOYMENT_NAME -n $NAMESPACE

echo -e "\nPod Status:"
kubectl get pods -l app.kubernetes.io/name=$(echo $DEPLOYMENT_NAME | cut -d'-' -f1) -n $NAMESPACE

echo -e "\nRollout History:"
kubectl rollout history deployment/$DEPLOYMENT_NAME -n $NAMESPACE
EOF

chmod +x monitor-deployment.sh

# Create health check script
cat << 'EOF' > health-check.sh
#!/bin/bash

URL=$1
EXPECTED_VERSION=$2
MAX_ATTEMPTS=${3:-30}
DELAY=${4:-2}

if [ -z "$URL" ] || [ -z "$EXPECTED_VERSION" ]; then
    echo "Usage: $0 <url> <expected-version> [max-attempts] [delay]"
    exit 1
fi

echo "Health checking $URL for version $EXPECTED_VERSION"
echo "Max attempts: $MAX_ATTEMPTS, Delay: ${DELAY}s"

for i in $(seq 1 $MAX_ATTEMPTS); do
    echo -n "Attempt $i: "
    
    RESPONSE=$(curl -s -H "Host: sample-app.local" $URL 2>/dev/null)
    
    if echo "$RESPONSE" | grep -q "Version $EXPECTED_VERSION"; then
        echo "SUCCESS - Found expected version $EXPECTED_VERSION"
        exit 0
    else
        FOUND_VERSION=$(echo "$RESPONSE" | grep -o "Version [0-9.]*" || echo "No version found")
        echo "WAITING - Found: $FOUND_VERSION, Expected: Version $EXPECTED_VERSION"
    fi
    
    sleep $DELAY
done

echo "FAILED - Expected version not found after $MAX_ATTEMPTS attempts"
exit 1
EOF

chmod +x health-check.sh

# Test the monitoring scripts
./monitor-deployment.sh sample-app-sample-app-chart
./health-check.sh http://localhost/ "1.0" 5 1
Subtask 2.10: Automated Rollback on Failure
Create an automated rollback mechanism:

# Create automated rollback script
cat << 'EOF' > auto-rollback.sh
#!/bin/bash

RELEASE_NAME=$1
CHART_PATH=$2
NEW_VERSION=$3
HEALTH_CHECK_URL=$4
TIMEOUT=${5:-300}

if [ -z "$RELEASE_NAME" ] || [ -z "$CHART_PATH" ] || [ -z "$NEW_VERSION" ] || [ -z "$HEALTH_CHECK_URL" ]; then
    echo "Usage: $0 <release-name> <chart-path> <new-version> <health-check-url> [timeout]"
    exit 1
fi

echo "Starting automated deployment with rollback capability"
echo "Release: $RELEASE_NAME"
echo "New Version: $NEW_VERSION"
echo "Timeout: ${TIMEOUT}s"

# Store current revision for rollback
CURRENT_REVISION=$(helm history $RELEASE_NAME | tail -n 1 | awk '{print $1}')
echo "Current revision: $CURRENT_REVISION"

# Perform upgrade
echo "Upgrading to version $NEW_VERSION..."
helm upgrade $RELEASE_NAME $CHART_PATH --set image.tag=$NEW_VERSION

# Wait for rollout to complete
echo "Waiting for rollout to complete..."
DEPLOYMENT_NAME=$(kubectl get deployments -l app.kubernetes.io/instance=$RELEASE_NAME -o jsonpath='{.items[0].metadata.name}')

if ! kubectl rollout status deployment/$DEPLOYMENT_NAME --timeout=${TIMEOUT}s; then
    echo "Rollout failed or timed out. Initiating rollback..."
    helm rollback $RELEASE_NAME $CURRENT_REVISION
    kubectl rollout status deployment/$DEPLOYMENT_NAME --timeout=120s
    echo "Rollback completed"
    exit 1
fi

# Perform health check
echo "Performing health check..."
if ./health-check.sh $HEALTH_CHECK_URL $NEW_VERSION 10 3; then
    echo "Deployment successful and healthy"
    exit 0
else
    echo "Health check failed. Initiating rollback..."
    helm rollback $RELEASE_NAME $CURRENT_REVISION
    kubectl rollout status deployment/$DEPLOYMENT_NAME --timeout=120s
    echo "Rollback completed due to health check failure"
    exit 1
fi
EOF

chmod +x auto-rollback.sh

# Test automated rollback with a failing deployment
echo "Testing automated rollback with non-existent image..."
./auto-rollback.sh sample-app ./sample-app-chart v999.0 http://localhost/

# Test successful deployment
echo "Testing successful deployment..."
./auto-rollback.sh sample-app ./sample-app-chart v2.0 http://localhost/
