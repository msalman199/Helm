Subtask 3.6: Working with Dependency Aliases
Step 1: Modify Chart.yaml to use aliases for multiple instances

cat > Chart.yaml << 'EOF'
apiVersion: v2
name: webapp-with-deps
description: A Helm chart for a web application with dependencies
type: application
version: 0.1.0
appVersion: "1.0"

dependencies:
  - name: redis
    version: "17.15.6"
    repository: "https://charts.bitnami.com/bitnami"
    condition: redis.enabled
    alias: cache
  - name: redis
    version: "17.15.6"
    repository: "https://charts.bitnami.com/bitnami"
    condition: session-store.enabled
    alias: session-store
  - name: postgresql
    version: "12.12.10"
    repository: "https://charts.bitnami.com/bitnami"
    condition: postgresql.enabled
EOF
Step 2: Update values.yaml for aliases

cat > values.yaml << 'EOF'
replicaCount: 1

image:
  repository: nginx
  pullPolicy: IfNotPresent
  tag: "1.21"

service:
  type: ClusterIP
  port: 80

# Cache Redis instance
cache:
  enabled: true
  auth:
    enabled: false
  master:
    persistence:
      enabled: false

# Session store Redis instance
session-store:
  enabled: true
  auth:
    enabled: false
  master:
    persistence:
      enabled: false
    service:
      ports:
        redis: 6380

postgresql:
  enabled: true
  auth:
    postgresPassword: "mypassword"
    database: "webapp"
  primary:
    persistence:
      enabled: false
EOF
Step 3: Update dependencies and install

helm dependency update
helm upgrade my-webapp . --namespace webapp-demo
Task 4: Advanced Dependency Management
Subtask 4.1: Dependency Conditions and Tags
Step 1: Create a more complex Chart.yaml with tags

cat > Chart.yaml << 'EOF'
apiVersion: v2
name: webapp-with-deps
description: A Helm chart for a web application with dependencies
type: application
version: 0.1.0
appVersion: "1.0"

dependencies:
  - name: redis
    version: "17.15.6"
    repository: "https://charts.bitnami.com/bitnami"
    condition: redis.enabled
    tags:
      - cache
      - database
  - name: postgresql
    version: "12.12.10"
    repository: "https://charts.bitnami.com/bitnami"
    condition: postgresql.enabled
    tags:
      - database
      - persistent
  - name: nginx
    version: "15.4.4"
    repository: "https://charts.bitnami.com/bitnami"
    condition: nginx.enabled
    tags:
      - frontend
EOF
Step 2: Create values.yaml with tag controls

cat > values.yaml << 'EOF'
# Tag-based enabling/disabling
tags:
  database: true
  cache: false
  frontend: false
  persistent: true

# Individual service configurations
redis:
  enabled: true
  auth:
    enabled: false
  master:
    persistence:
      enabled: false

postgresql:
  enabled: true
  auth:
    postgresPassword: "mypassword"
    database: "webapp"
  primary:
    persistence:
      enabled: false

nginx:
  enabled: false
EOF
Subtask 4.2: Dependency Import Values
Step 1: Create a Chart.yaml with import-values

cat > Chart.yaml << 'EOF'
apiVersion: v2
name: webapp-with-deps
description: A Helm chart for a web application with dependencies
type: application
version: 0.1.0
appVersion: "1.0"

dependencies:
  - name: postgresql
    version: "12.12.10"
    repository: "https://charts.bitnami.com/bitnami"
    condition: postgresql.enabled
    import-values:
      - child: auth.postgresPassword
        parent: database.password
      - child: auth.database
        parent: database.name
EOF
